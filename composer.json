{
    "name": "happenv-com/filament-enhanced-charts",
    "description": "Apache ECharts integration for Filament",
    "license": "MIT",
    "keywords": [
        "happenv",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-echarts",
        "filament-enhanced-charts"
    ],
    "authors": [
        {
            "name": "Happenv sp. z o.o.",
            "email": "code@happenv.com",
            "homepage": "https://happenv.com",
            "role": "Maintainer"
        },
        {
            "name": "webard",
            "email": "code@webard.me",
            "homepage": "https://github.com/webard",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/happenv-com/filament-enhanced-charts",
    "support": {
        "issues": "https://github.com/happenv-com/filament-enhanced-charts/issues",
        "source": "https://github.com/happenv-com/filament-enhanced-charts",
        "security": "https://github.com/happenv-com/filament-enhanced-charts/security/policy"
    },
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.1",
        "ergebnis/composer-normalize": "^2.48",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-arch": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.1"
    },
    "suggest": {
        "flowframe/laravel-trend": "Time-series aggregation (per day/week/month, gap-filled) for chart widgets; feed its result to Happenv\\FilamentEnhancedCharts\\Data\\ChartData::fromTimeSeries()."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Happenv\\FilamentEnhancedCharts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\FilamentEnhancedCharts\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Happenv\\FilamentEnhancedCharts\\FilamentEnhancedChartsServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "ci": [
            "@normalize-composer-test",
            "@rector-test",
            "@pint-test",
            "@phpstan",
            "@test"
        ],
        "cs": [
            "@normalize-composer",
            "@rector",
            "@pint"
        ],
        "normalize-composer": "@composer normalize --ansi",
        "normalize-composer-test": "@composer normalize --dry-run --ansi",
        "phpstan": "phpstan analyse --ansi",
        "pint": "pint",
        "pint-test": "pint --test",
        "rector": "rector process",
        "rector-test": "rector process --dry-run",
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ci": "Runs every CI gate locally: composer.json normalization, Rector, Pint, PHPStan and the test suite.",
        "cs": "Fixes code style: composer normalize, Rector, then Pint (Rector adds imports, Pint sorts them).",
        "normalize-composer": "Normalizes composer.json.",
        "normalize-composer-test": "Checks composer.json is normalized.",
        "phpstan": "Runs PHPStan.",
        "pint": "Formats the code with Pint.",
        "pint-test": "Checks the code style with Pint.",
        "rector": "Applies Rector refactorings.",
        "rector-test": "Shows pending Rector refactorings.",
        "test": "Runs the test suite.",
        "test-coverage": "Runs the test suite with code coverage (needs pcov or Xdebug)."
    }
}
