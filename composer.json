{
    "name": "happenv-com/filament-enhanced-charts",
    "description": "Apache ECharts integration for Filament",
    "keywords": [
        "happenv",
        "laravel",
        "filamentphp",
        "filament-echarts"
    ],
    "homepage": "https://github.com/happenv-com/filament-enhanced-charts",
    "support": {
        "issues": "https://github.com/happenv-com/filament-enhanced-charts/issues",
        "source": "https://github.com/happenv-com/filament-enhanced-charts"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "webard",
            "email": "code@webard.me",
            "role": "Developer"
        },
        {
            "name": "Happenv sp. z o.o.",
            "email": "code@happenv.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "suggest": {
        "flowframe/laravel-trend": "Time-series aggregation (per day/week/month, gap-filled) for chart widgets; feed its result to Happenv\\FilamentEnhancedCharts\\Data\\ChartData::fromTimeSeries()."
    },
    "autoload": {
        "psr-4": {
            "Happenv\\FilamentEnhancedCharts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\FilamentEnhancedCharts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Happenv\\FilamentEnhancedCharts\\FilamentEnhancedChartsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
