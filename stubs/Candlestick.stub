<?php

namespace $NAMESPACE$;

use Happenv\FilamentEnhancedCharts\Option\Axis\CategoryAxis;
use Happenv\FilamentEnhancedCharts\Option\Option;
use Happenv\FilamentEnhancedCharts\Option\Series\CandlestickSeries;
use Happenv\FilamentEnhancedCharts\Widgets\EnhancedChartWidget;

class $CLASS_NAME$ extends EnhancedChartWidget
{
    protected static ?string $chartId = '$CHART_ID$';

    protected static ?string $heading = '$CLASS_NAME$';

    /**
     * Build the chart with the typed option model.
     * ECharts option reference: https://echarts.apache.org/en/option.html
     */
    protected function getOption(): Option
    {
        return Option::cartesian()
            ->xAxis(CategoryAxis::make()->data(['2026-01-05', '2026-01-06', '2026-01-07', '2026-01-08']))
            ->series(
                CandlestickSeries::make()
                    ->name('$CLASS_NAME$')
                    // Each row: [open, close, lowest, highest].
                    ->data([
                        [20, 34, 10, 38],
                        [40, 35, 30, 50],
                        [31, 38, 33, 44],
                        [38, 15, 5, 42],
                    ]),
            );
    }
}
